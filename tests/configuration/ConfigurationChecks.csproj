<Project Sdk="Microsoft.NET.Sdk">
    <!-- Reuse the installation path already configured for development. -->
    <Import Project="../../streamerbot/StreamerBot.local.props" />

    <PropertyGroup>
        <TargetFramework>net481</TargetFramework>
        <OutputType>Exe</OutputType>
        <PlatformTarget>x64</PlatformTarget>
        <LangVersion>7.3</LangVersion>
        <Nullable>disable</Nullable>
        <ImplicitUsings>disable</ImplicitUsings>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference
            Include="Microsoft.NETFramework.ReferenceAssemblies.net481"
            Version="1.0.3"
            PrivateAssets="all"
        />

        <!-- This standalone program needs the JSON DLL beside its executable. -->
        <Reference Include="Newtonsoft.Json">
            <HintPath>$(StreamerBotPath)/Newtonsoft.Json.dll</HintPath>
            <Private>true</Private>
        </Reference>

        <!-- Compile the real configuration code, without copying its source. -->
        <Compile
            Include="../../streamerbot/configuration/*.cs"
            Link="Configuration/%(Filename)%(Extension)"
        />
    </ItemGroup>
</Project>
{
  "name": "pokehunter-seasons",
  "version": "0.1.0",
  "private": true,
  "description": "A seasonal Pokemon catching game for Streamer.bot.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build:tools": "tsc",
    "import:sample": "npm run build:tools && node dist/import-pokemon.js",
    "import:regular-sample": "npm run build:tools && node dist/import-regular-sample.js",
    "import:gen1": "npm run build:tools && node dist/import-generation-one.js",
    "import:event-families": "npm run build:tools && node dist/import-event-families.js",
    "review:event-types": "npm run build:tools && node dist/review-event-types.js",
    "inspect:event-forms": "npm run build:tools && node dist/inspect-event-forms.js",
    "import:reviewed-ghosts": "npm run build:tools && node dist/import-reviewed-ghosts.js",
    "inspect:event-variants": "npm run build:tools && node dist/inspect-event-variants.js",
    "test:tools": "npm run build:tools && node --test dist/tests/catalogue.test.js dist/tests/event-variants.test.js dist/tests/merge-collection-entries.test.js",
    "import:event-variants": "npm run build:tools && node dist/import-event-variants.js",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "check": "npm run typecheck && npm run lint && npm run test:tools && npm run format:check"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "jiti": "^2.7.0",
    "prettier": "3.9.9",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.71.0"
  }
}
